{
  "id": "f10de5c0-4034-49aa-b72a-0821687472c6",
  "name": "postgresql",
  "kind": "postgresql",
  "type": "default",
  "options": {
    "development": {
      "host": "localhost",
      "port": 5432,
      "database": "sample_db",
      "ssh_port": 22,
      "username": "postgres",
      "ssh_enabled": "disabled",
      "ssl_enabled": false,
      "ssh_auth_type": "private_key",
      "connection_type": "manual",
      "ssl_certificate": "none",
      "allow_dynamic_connection_parameters": false
    },
    "production": {
      "host": "localhost",
      "port": 5432,
      "ssh_port": 22,
      "ssh_enabled": "disabled",
      "ssl_enabled": true,
      "ssh_auth_type": "private_key",
      "connection_type": "manual",
      "ssl_certificate": "none",
      "allow_dynamic_connection_parameters": false
    },
    "staging": {
      "host": "localhost",
      "port": 5432,
      "ssh_port": 22,
      "ssh_enabled": "disabled",
      "ssl_enabled": true,
      "ssh_auth_type": "private_key",
      "connection_type": "manual",
      "ssl_certificate": "none",
      "allow_dynamic_connection_parameters": false
    }
  }
}