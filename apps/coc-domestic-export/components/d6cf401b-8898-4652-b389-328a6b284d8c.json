      "value": "{{((email)=>{const name=email?email.split('@')[0].split('.').map(s=>s.charAt(0).toUpperCase()+s.slice(1)).join(' '):'User';return '<div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 24px;background:linear-gradient(rgba(255,255,255,0.96),rgba(247,248,251,0.85));border-bottom:1px solid var(--line);font-family:inherit\"><div style=\"display:flex;align-items:center;gap:14px;flex-shrink:0\"><strong style=\"font-size:15px;letter-spacing:-0.01em;color:var(--text)\">City Operator Console</strong><span style=\"font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted)\">Porter</span></div><div style=\"display:flex;align-items:center;gap:10px;padding:6px 14px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,0.84);flex-shrink:0\"><div style=\"width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#c4d0ee,#7e94d6)\"></div><strong style=\"font-size:13px;color:var(--text)\">'+name+'</strong></div></div>';})((globals && globals.currentUser && globals.currentUser.email) || '')}}"
